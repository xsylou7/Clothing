; Engine configuration file.
; Godot 4.7 Philia dressing prototype

config_version=5

[application]

config/name="Philia"
config/description="Dressing intelligent — prototype visuel"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AppState="*res://scripts/autoload/app_state.gd"
Nav="*res://scripts/autoload/nav.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/size/window_width_override=390
window/size/window_height_override=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://assets/theme/philia_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
